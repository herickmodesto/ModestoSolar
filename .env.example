# Google Maps JavaScript API key with Maps JavaScript API enabled
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Separate key with Google Solar API enabled and billing active
VITE_GOOGLE_SOLAR_API_KEY=your_google_solar_api_key

# Public production URL. Used at build time for canonical, sitemap and sharing.
VITE_SITE_URL=

# Enable only after activating Speed Insights for the Vercel project.
VITE_ENABLE_SPEED_INSIGHTS=false
